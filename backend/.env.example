# Backend environment variables - example file.
# Copy only for local reference. Configure real values in the cloud provider.

PORT=8081

# PostgreSQL
# Use a JDBC URL. Example:
# jdbc:postgresql://host:5432/database_name
DATABASE_URL=jdbc:postgresql://localhost:5432/ferremas_db
DB_USERNAME=postgres
DB_PASSWORD=admin123
DDL_AUTO=update
SHOW_SQL=false
SQL_LOG_LEVEL=INFO

# JWT
# Use a strong secret with at least 32 bytes in production.
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_bytes
JWT_EXPIRATION_MS=3600000

# CORS
# Include the final Vercel URL and local URLs if needed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Customer lookup
CUSTOMER_LOOKUP_ENABLED=true
CUSTOMER_LOOKUP_PROVIDER=APIDNI
CUSTOMER_LOOKUP_TOKEN=
CUSTOMER_LOOKUP_DNI_URL=https://apidni.com/api/v2/dni/{document}
SUNAT_RUC_PADRON_URL=https://www2.sunat.gob.pe/padron_reducido_ruc.zip
